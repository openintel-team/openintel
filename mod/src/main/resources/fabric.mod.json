{
  "schemaVersion": 1,
  "id": "openintel",
  "version": "${version}",
  "name": "OpenIntel",
  "icon": "assets/openintel/icon.png",
  "description": "OpenIntel shares relay intelligence and draws it, relic maps and the relic library, and War Table names on the fullscreen map of JourneyMap or Xaero's World Map. It also provides block-aligned coverage and log investigation.",
  "authors": ["OpenIntel contributors"],
  "license": "MIT",
  "environment": "client",
  "custom": {
    "openintel:api_version": 1
  },
  "entrypoints": {
    "client": ["dev.openintel.OpenIntelClient"],
    "journeymap": ["dev.openintel.jm.OpenIntelJmPlugin"],
    "modmenu": ["dev.openintel.compat.ModMenuIntegration"]
  },
  "mixins": ["openintel.mixins.json"],
  "accessWidener": "openintel.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*",
    "chesttracker": "*",
    "whereisit": "*",
    "journeymap": "*",
    "xaeroworldmap": "*"
  }
}
