{
  "schemaVersion": 1,
  "id": "openintel",
  "version": "${version}",
  "name": "OpenIntel",
  "icon": "assets/openintel/icon.png",
  "description": "Open-source position sharing for Civ servers. Friends green, allies purple, enemies red, neutrals grey. Relay + Discord webhook alerts.",
  "authors": ["OpenIntel contributors"],
  "license": "MIT",
  "environment": "client",
  "custom": {
    "openintel:api_version": 1
  },
  "entrypoints": {
    "client": ["dev.openintel.OpenIntelClient"],
    "journeymap": ["dev.openintel.jm.OpenIntelJmPlugin"],
    "modmenu": ["dev.openintel.compat.ModMenuIntegration"]
  },
  "mixins": ["openintel.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*",
    "chesttracker": "*",
    "whereisit": "*",
    "xaeroworldmap": "*"
  }
}
